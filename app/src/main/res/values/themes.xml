<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ponto.Base" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/verde</item>
        <item name="colorPrimaryVariant">@color/verde_escuro</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/destaque</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">@color/verde_escuro</item>
        <item name="materialButtonStyle">@style/Widget.Ponto.Botao</item>
    </style>

    <!-- Verde com texto branco; cinza quando indisponível (enabled = false). -->
    <style name="Widget.Ponto.Botao" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/botao_fundo</item>
        <item name="android:textColor">@color/botao_texto</item>
    </style>

    <!-- Configurações: título de seção (verde, maiúsculas), explicação embaixo de cada opção e
         divisória entre seções. -->
    <style name="Ponto.Secao" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/verde</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Ponto.Explicacao" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Ponto.Divisoria" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <style name="Ponto.Campo" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Theme.Ponto" parent="Theme.Ponto.Base" />
</resources>
