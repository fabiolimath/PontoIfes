<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ponto.Base" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/verde</item>
        <item name="colorPrimaryVariant">@color/verde_escuro</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/destaque</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">@color/verde_escuro</item>
        <item name="materialButtonStyle">@style/Widget.Ponto.Botao</item>
    </style>

    <!-- Verde com texto branco; cinza quando indisponível (enabled = false). -->
    <style name="Widget.Ponto.Botao" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/botao_fundo</item>
        <item name="android:textColor">@color/botao_texto</item>
    </style>

    <style name="Theme.Ponto" parent="Theme.Ponto.Base" />
</resources>
